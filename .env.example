# Скопируйте этот файл в .env и вставьте ключи из Supabase:
# Project Settings → API → Project URL и anon public key.
# Те же две переменные добавьте в Vercel → Project → Settings → Environment Variables.
# service_role ключ сюда НЕ класть.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
