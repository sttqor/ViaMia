# Скопируйте этот файл в .env и вставьте ключи из Supabase:
# Project Settings → API → Project URL и anon public key.
# Те же две переменные добавьте в Vercel → Project → Settings → Environment Variables.
# service_role ключ сюда НЕ класть.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Тестовый вход (только для проверки, настоящих SMS нет — см. supabase/auth-setup.md, шаг 4):
#   телефон +996 700 000 001 или +996 555 000 002, код всегда 123456
#   пароль тестового аккаунта +996 700 000 001: OshTest-2026
